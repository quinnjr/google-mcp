{
  "name": "@quinnjr/google-mcp",
  "version": "2.0.0",
  "description": "Model Context Protocol (MCP) server for Google Workspace - Calendar, Gmail, Drive, Docs, Sheets, Slides, Meet, Chat, Forms, YouTube, Tasks, and Contacts with OAuth 2.0 authentication",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "google-mcp": "./dist/index.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "!dist/__tests__/**",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnjr/google-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/quinnjr/google-mcp/issues"
  },
  "homepage": "https://github.com/quinnjr/google-mcp#readme",
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "prebuild": "pnpm clean",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prepublishOnly": "pnpm lint && pnpm test:coverage && pnpm build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google",
    "google-workspace",
    "google-calendar",
    "gmail",
    "google-drive",
    "google-docs",
    "google-sheets",
    "google-slides",
    "google-meet",
    "google-chat",
    "google-forms",
    "youtube",
    "google-tasks",
    "google-contacts",
    "oauth",
    "oauth2",
    "ai",
    "claude",
    "cursor",
    "llm"
  ],
  "author": "Joseph R. Quinn",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "googleapis": "^176.0.0",
    "open": "^11.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
